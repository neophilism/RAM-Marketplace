# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ram_marketplace
RAM_DATA_BACKEND=postgres

# Signed session cookies. Use a long random value in deployed environments.
AUTH_SECRET=replace-with-a-long-random-secret

# Public self-onboarding is disabled by default in production.
RAM_PUBLIC_ONBOARDING_ENABLED=false

# Demo role login is automatically available in local development.
# Set true explicitly on a controlled demo deployment if desired.
RAM_DEMO_AUTH_ENABLED=false
