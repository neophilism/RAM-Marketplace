# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ram_marketplace
RAM_DATA_BACKEND=postgres

# Signed session cookies. Use a long random value in deployed environments.
AUTH_SECRET=replace-with-a-long-random-secret

# Verified external identity boundary. The assertion secret must be distinct
# from AUTH_SECRET and shared only with the trusted identity gateway.
RAM_IDENTITY_ASSERTION_SECRET=replace-with-a-separate-long-random-secret
RAM_IDENTITY_ALLOWED_PROVIDERS=enterprise-oidc
RAM_IDENTITY_LOGIN_URL=https://identity.example.com/login
RAM_IDENTITY_REQUIRE_MFA=true


# Provider-neutral payment execution gateway. Use a separate signing secret.
# The gateway receives signed idempotent execution instructions and posts
# signed status webhooks back to /api/payments/webhook.
RAM_PAYMENT_GATEWAY_NAME=production-gateway
RAM_PAYMENT_GATEWAY_URL=https://payments.example.com
RAM_PAYMENT_GATEWAY_SECRET=replace-with-a-separate-payment-gateway-secret
RAM_PAYMENT_GATEWAY_ALLOW_INSECURE_LOCAL=false

# Unverified public self-onboarding is disabled by default in production.
RAM_PUBLIC_ONBOARDING_ENABLED=false

# Demo role login is automatically available in local development.
# Set true explicitly on a controlled demo deployment if desired.
RAM_DEMO_AUTH_ENABLED=false


# Maximum Content-Length accepted for unsafe API methods.
# Default: 1048576 (1 MiB). Keep ordinary structured workflow requests small.
RAM_MAX_MUTATION_BYTES=1048576

# Recommended infrastructure controls outside the application:
# - TLS termination with trusted Host forwarding
# - edge/WAF request throttling in addition to application onboarding/demo limits
# - PostgreSQL encryption/backups and restricted network access
