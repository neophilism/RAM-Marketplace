generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrganizationType {
  FARM
  RESEARCH_INSTITUTION
  BIOTECH
  PHARMA
  CRO
  VETERINARY
  LOGISTICS
  RAM
}

enum MembershipRole {
  SUPPLIER_OWNER_ADMIN
  SUPPLIER_STAFF
  RESEARCH_PI
  RESEARCH_PROCUREMENT
  RESEARCH_COMPLIANCE
  VETERINARIAN
  TRANSPORT_PROVIDER
  RAM_MARKETPLACE_OPS
  RAM_COMPLIANCE
  RAM_FINANCE_ADMIN
  RAM_SUPER_ADMIN
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CandidateStatus {
  DRAFT
  SUBMITTED
  PRE_SCREENED
  VET_PENDING
  VERIFIED
  MATCHABLE
  RESERVED
  SOLD_TO_RAM
  TRANSFERRED
  WITHDRAWN
  CULLED
  EXPIRED
  INELIGIBLE
  QUARANTINED
  SUSPENDED
}

enum OrderStatus {
  DRAFT
  CANDIDATE_HELD
  CHECKOUT_PENDING
  BUYER_COMMITTED
  ACQUISITION_COMMITTED
  CLEARANCE_PENDING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  ACCEPTED
  SETTLED
  CLOSED
  EXPIRED
  CLEARANCE_FAILED
  SUPPLIER_WITHDRAWN
  BUYER_CANCELLED
  TRANSPORT_EXCEPTION
  REJECTED_AT_RECEIPT
  DISPUTED
}

enum ResearchNeedStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  ACTIVE
  MATCH_REVIEW
  SELECTED
  INSTITUTIONAL_CLEARANCE
  ORDERED
  IN_STUDY
  COMPLETED
  CLOSED
}

enum ProtocolStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  APPROVED
}

enum DisclosureTier {
  PUBLIC_ANONYMIZED
  REQUESTABLE
  POST_RESERVATION
  POST_PURCHASE
  RAM_INTERNAL_ONLY
}

enum DisclosureRequestStatus {
  PENDING_RAM_REVIEW
  PENDING_SUPPLIER_APPROVAL
  APPROVED
  DENIED
  RELEASED
  CLOSED
}

enum VeterinaryReviewOutcome {
  PENDING
  NEEDS_DIAGNOSTICS
  ELIGIBLE
  INELIGIBLE
  WELFARE_HOLD
}

enum ResearchMatchStatus {
  CANDIDATE
  SHORTLISTED
  SELECTED
  REJECTED
  STALE
}

enum ClearanceDecision {
  PENDING
  CLEARED
  FAILED
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  type          OrganizationType
  status        OrganizationStatus @default(PENDING_VERIFICATION)
  memberships   Membership[]
  farmSites     FarmSite[]
  facilities    Facility[]
  buyerOrders   Order[]          @relation("BuyerOrganizationOrders")
  researchNeeds ResearchNeed[]
  disclosureRequests DisclosureRequest[] @relation("DisclosureRequesterOrganization")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  emailVerifiedAt    DateTime?
  name               String
  memberships        Membership[]
  createdNeeds       ResearchNeed[]      @relation("ResearchNeedCreator")
  veterinaryReviews  VeterinaryReview[]  @relation("VetReviewer")
  disclosureRequests DisclosureRequest[] @relation("DisclosureRequester")
  auditEvents        AuditEvent[]        @relation("AuditActor")
  ramReviewedDisclosures DisclosureRequest[] @relation("DisclosureRamReviewer")
  supplierReviewedDisclosures DisclosureRequest[] @relation("DisclosureSupplierReviewer")
  createdOrders      Order[]             @relation("OrderCreator")
  clearanceReviews   OrderClearance[]    @relation("ClearanceReviewer")
  pricingPolicies    SupplierPricingPolicy[] @relation("PricingPolicyCreator")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  status         MembershipStatus @default(INVITED)
  user           User             @relation(fields: [userId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId, role])
  @@index([organizationId, status])
}

model Facility {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  facilityType   String
  regionLabel    String
  exactAddress   String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model FarmSite {
  id             String                @id @default(cuid())
  organizationId String
  internalLabel  String
  regionLabel    String
  exactAddress   String
  countyLabel    String?
  organization   Organization          @relation(fields: [organizationId], references: [id])
  sourceRecords  AnimalSourceRecord[]
  permissions    FarmDisclosurePolicy?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId])
}

model FarmDisclosurePolicy {
  id                        String   @id @default(cuid())
  farmSiteId                String   @unique
  shareGeneralHusbandry     Boolean  @default(true)
  shareCountyAfterNda       Boolean  @default(false)
  shareIdentityPrePurchase  Boolean  @default(false)
  shareIdentityPostPurchase Boolean  @default(true)
  farmSite                  FarmSite @relation(fields: [farmSiteId], references: [id])
  updatedAt                 DateTime @updatedAt
}

model AnimalCase {
  publicId             String              @id
  species              String
  breed                String?
  sex                  String?
  ageMonths            Int?
  weightKg             Float?
  condition            String
  diseaseStage         String?
  etiology             String?
  diagnosticConfidence String?
  comorbidities        Json?
  diagnosticEvidence   Json?
  regionLabel          String
  publicSummary        String
  phenotype            Json?
  availabilityText     String?
  sourceDisclosure     DisclosureTier      @default(PUBLIC_ANONYMIZED)
  status               CandidateStatus     @default(DRAFT)
  listPriceCents       Int?
  transportReady       Boolean             @default(false)
  sourceRecord         AnimalSourceRecord?
  cullEvent            CullEvent?
  veterinaryReviews    VeterinaryReview[]
  disclosureRequests   DisclosureRequest[]
  orders               Order[]
  matches              ResearchMatch[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([species, condition, status])
  @@index([status, regionLabel])
}

model AnimalSourceRecord {
  id                String     @id @default(cuid())
  animalCaseId      String     @unique
  farmSiteId        String
  exactAddress      String
  legalOwnerName    String
  ownerContactName  String
  ownerContactEmail String
  localVetName      String?
  localVetContact   String?
  privateHistory    Json?
  generalHusbandry String?
  privateNotes      String?
  animalCase        AnimalCase @relation(fields: [animalCaseId], references: [publicId])
  farmSite          FarmSite   @relation(fields: [farmSiteId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([farmSiteId])
}

model CullEvent {
  id                      String     @id @default(cuid())
  animalCaseId            String     @unique
  declaredAt              DateTime   @default(now())
  plannedCullAt           DateTime
  reason                  String
  independentlyIdentified Boolean    @default(true)
  animalCase              AnimalCase @relation(fields: [animalCaseId], references: [publicId])
}

model VeterinaryReview {
  id             String                  @id @default(cuid())
  animalCaseId   String
  reviewerUserId String
  outcome        VeterinaryReviewOutcome @default(PENDING)
  diagnosis      String?
  welfareNotes   String?
  diagnosticPlan       String?
  diseaseStage         String?
  etiology             String?
  diagnosticConfidence String?
  phenotype            Json?
  comorbidities        Json?
  diagnosticEvidence   Json?
  publicSummary        String?
  transportReady       Boolean?
  reviewedAt           DateTime?
  animalCase     AnimalCase              @relation(fields: [animalCaseId], references: [publicId])
  reviewer       User                    @relation("VetReviewer", fields: [reviewerUserId], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([animalCaseId, outcome])
}

model ResearchNeed {
  id                      String             @id @default(cuid())
  organizationId          String
  createdByUserId         String
  title                   String
  condition               String
  species                 String?
  minAgeMonths            Int?
  maxAgeMonths            Int?
  sex                     String?
  diseaseStage            String?
  etiologyRequirement     String?
  requiredPhenotype       String
  exclusionCriteria       String?
  acceptableComorbidities String?
  requiredDiagnostics     String?
  procedures              String?
  quantity                Int                @default(1)
  timeline                String
  budgetCents             Int?
  protocolStatus          ProtocolStatus
  scientificRationale     String
  status                  ResearchNeedStatus @default(DRAFT)
  organization            Organization       @relation(fields: [organizationId], references: [id])
  createdBy               User               @relation("ResearchNeedCreator", fields: [createdByUserId], references: [id])
  matches                 ResearchMatch[]
  orders                  Order[]
  disclosureRequests      DisclosureRequest[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([condition, species, status])
}

model ResearchMatch {
  id                   String              @id @default(cuid())
  researchNeedId       String
  animalCaseId         String
  status               ResearchMatchStatus @default(CANDIDATE)
  totalScore           Int
  phenotypeFit         Int
  diagnosticConfidence Int
  etiologyFit          Int
  comorbidityFit       Int
  timingAvailability   Int
  logisticsFit         Int
  priceFit             Int
  hardGates            Json
  reviewFlags          Json
  reasons              Json
  generatedAt          DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  researchNeed         ResearchNeed        @relation(fields: [researchNeedId], references: [id])
  animalCase           AnimalCase          @relation(fields: [animalCaseId], references: [publicId])

  @@unique([researchNeedId, animalCaseId])
  @@index([researchNeedId, totalScore])
  @@index([animalCaseId, status])
}

model DisclosureRequest {
  id                      String                  @id @default(cuid())
  animalCaseId            String
  requesterUserId         String
  requesterOrganizationId String
  researchNeedId          String
  orderId                 String?
  requestedFields         Json
  scientificReason        String
  status                  DisclosureRequestStatus @default(PENDING_RAM_REVIEW)
  supplierApproved        Boolean?
  reviewedByRam           Boolean                 @default(false)
  ramReviewerUserId       String?
  supplierReviewerUserId  String?
  ramReviewedAt           DateTime?
  supplierReviewedAt      DateTime?
  ndaRequired             Boolean                 @default(false)
  ndaAcceptedAt           DateTime?
  releasedFields          Json?
  releasedData            Json?
  denialReason            String?
  releasedAt              DateTime?
  animalCase              AnimalCase              @relation(fields: [animalCaseId], references: [publicId])
  requester               User                    @relation("DisclosureRequester", fields: [requesterUserId], references: [id])
  requesterOrganization   Organization            @relation("DisclosureRequesterOrganization", fields: [requesterOrganizationId], references: [id])
  researchNeed            ResearchNeed            @relation(fields: [researchNeedId], references: [id])
  order                   Order?                  @relation(fields: [orderId], references: [id])
  ramReviewer             User?                   @relation("DisclosureRamReviewer", fields: [ramReviewerUserId], references: [id])
  supplierReviewer        User?                   @relation("DisclosureSupplierReviewer", fields: [supplierReviewerUserId], references: [id])
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([animalCaseId, status])
  @@index([requesterOrganizationId, status])
  @@index([researchNeedId, status])
}

model Order {
  id                          String       @id @default(cuid())
  animalCaseId                String
  buyerOrganizationId         String
  researchNeedId              String
  createdByUserId             String
  status                      OrderStatus  @default(DRAFT)
  buyerPriceCents             Int?
  buyerPriceComponents        Json?
  supplierPricingPolicyId     String?
  supplierScheduleCents       Int?
  supplierMarketCeilingCents  Int?
  supplierAcquisitionCents    Int?
  directCostsCents            Int          @default(0)
  holdExpiresAt               DateTime?
  quoteIssuedAt               DateTime?
  quoteExpiresAt              DateTime?
  buyerCommittedAt            DateTime?
  acquisitionCommittedAt      DateTime?
  clearanceStartedAt          DateTime?
  clearedAt                   DateTime?
  receivingFacilityName       String?
  receivingFacilityAddress    String?
  protocolReference           String?
  institutionalApprovalAttested Boolean    @default(false)
  purchasingAuthorityAttested Boolean      @default(false)
  animalCase                  AnimalCase   @relation(fields: [animalCaseId], references: [publicId])
  buyerOrganization           Organization @relation("BuyerOrganizationOrders", fields: [buyerOrganizationId], references: [id])
  researchNeed                ResearchNeed @relation(fields: [researchNeedId], references: [id])
  createdBy                   User         @relation("OrderCreator", fields: [createdByUserId], references: [id])
  supplierPricingPolicy       SupplierPricingPolicy? @relation(fields: [supplierPricingPolicyId], references: [id])
  clearance                   OrderClearance?
  disclosureRequests          DisclosureRequest[]
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  @@index([animalCaseId, status])
  @@index([buyerOrganizationId, status])
  @@index([researchNeedId, status])
}

model SupplierPricingPolicy {
  id                           String   @id @default(cuid())
  species                      String
  standardizedCullScheduleCents Int
  marketCeilingCents           Int
  active                       Boolean  @default(true)
  effectiveFrom                DateTime @default(now())
  effectiveTo                  DateTime?
  createdByUserId              String
  createdBy                    User     @relation("PricingPolicyCreator", fields: [createdByUserId], references: [id])
  orders                       Order[]
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([species, active, effectiveFrom])
}

model OrderClearance {
  id                           String            @id @default(cuid())
  orderId                      String            @unique
  reviewerUserId               String?
  decision                     ClearanceDecision @default(PENDING)
  protocolConfirmed            Boolean           @default(false)
  receivingFacilityConfirmed   Boolean           @default(false)
  welfareConfirmed             Boolean           @default(false)
  biosecurityConfirmed         Boolean           @default(false)
  movementRequirementsConfirmed Boolean          @default(false)
  transportPlanConfirmed       Boolean           @default(false)
  sourceProvenanceConfirmed    Boolean           @default(false)
  blockingFindings             Json?
  notes                        String?
  reviewedAt                   DateTime?
  order                        Order             @relation(fields: [orderId], references: [id])
  reviewer                     User?             @relation("ClearanceReviewer", fields: [reviewerUserId], references: [id])
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
}

model AuditEvent {
  id             String   @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  previousState  Json?
  nextState      Json?
  reason         String?
  correlationId  String?
  metadata       Json?
  actor          User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}
