{
  "name": "ram-marketplace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:drift": "prisma migrate diff --exit-code --from-config-datasource --to-schema prisma/schema.prisma",
    "db:seed:e2e": "tsx scripts/seed-e2e-postgres.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore:verify": "bash scripts/db-restore-verify.sh",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e:prototype": "node scripts/e2e-prototype.mjs",
    "e2e:live": "node scripts/e2e-prototype.mjs",
    "e2e:identity": "tsx scripts/identity-lifecycle-e2e.ts",
    "e2e:payments": "tsx scripts/payment-lifecycle-e2e.ts",
    "e2e:monitoring": "tsx scripts/monitoring-lifecycle-e2e.ts",
    "payments:fake-gateway": "node scripts/fake-payment-gateway.mjs",
    "monitoring:fake-alert": "node scripts/fake-monitoring-alert-receiver.mjs",
    "pilot:check": "tsx scripts/pilot-readiness.ts",
    "check": "npm run prisma:validate && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.2.3",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
